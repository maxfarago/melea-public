# Auth — customer Clerk app
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_AUTHORIZED_PARTIES=http://localhost:8000
CLERK_WEBHOOK_SECRET=

# Auth — separate ops Clerk app. empty publishable key disables /api/ops/*
CLERK_OPS_PUBLISHABLE_KEY=
CLERK_OPS_SECRET_KEY=
CLERK_OPS_AUTHORIZED_PARTIES=

SITE_ACCESS_PASSWORD=
SITE_GATE_COOKIE_SECRET=
