GA_MEASUREMENT_ID=

# LLM providers
ANTHROPIC_API_KEY=
ANTHROPIC_ADMIN_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
XAI_ADMIN_KEY=
XAI_TEAM_ID=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4

# SQS (leave empty locally to disable consumer)
SQS_QUEUE_URL=
AWS_REGION=eu-central-1

# sitmar campaign images. empty bucket = images skipped
SITMAR_IMAGES_S3_BUCKET=
SITMAR_IMAGE_TIMEOUT_SECONDS=60
AUDIENCE_IMAGES_S3_BUCKET=
CDN_BASE_URL=

# Jina AI — keyless r.jina.ai works without; key unlocks s.jina.ai search
JINA_API_KEY=
SCRAPINGBEE_API_KEY=

TWITTER_BEARER_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_LINK_STARTER_MONTHLY=
STRIPE_LINK_STARTER_ANNUAL=
STRIPE_LINK_PRO_MONTHLY=
STRIPE_LINK_PRO_ANNUAL=

